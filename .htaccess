# ─────────────────────────────────────────────────────────────
# Hostinger Shared Hosting Apache / LiteSpeed Configuration
# ─────────────────────────────────────────────────────────────

RewriteEngine On
RewriteBase /

# Route all /api/* requests to api.php proxy
RewriteRule ^api/(.*)$ api.php?endpoint=$1 [QSA,L]
RewriteRule ^api$ api.php [QSA,L]

# Directory index: prioritize index.php
DirectoryIndex index.php index.html

# Block direct access to data/config files
<FilesMatch "(\.json|\.log|Dockerfile|\.md)$">
    Require all denied
</FilesMatch>
